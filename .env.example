NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:replace-with-password@127.0.0.1:5432/reel_studio"
REDIS_URL="redis://127.0.0.1:6379"
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64
MEDIA_URL_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/oauth/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Uploads are always saved under Server/data/media. Fill these to also copy them into one folder in object storage.
S3_BUCKET=
S3_REGION=default
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=reel-studio
