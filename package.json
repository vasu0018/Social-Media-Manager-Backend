{
  "name": "reel-studio-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "prisma migrate deploy && tsx src/index.ts",
    "test": "tsx --test test/security.test.ts test/publishing.test.ts",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@prisma/client": "^6.16.3",
    "bullmq": "^6.3.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "multer": "^2.0.2",
    "prisma": "^6.16.3",
    "redis-memory-server": "^0.17.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
